# Server Configuration
PORT=3000

# MongoDB Connection String (e.g. mongodb://localhost:27017/hostel or MongoDB Atlas URI)
# If omitted or connection fails, the app uses a persistent fallback datastore (no MongoDB required)
MONGO_URI="mongodb://localhost:27017/hostel"

# Vite HMR WebSocket Port (optional, defaults to 24678)
# Change this if port 24678 is already in use
HMR_PORT=24678

# JWT Secret for signing tokens
JWT_SECRET="super-secret-jwt-key-hostel-system-2026"

# Admin Secret Code required to register as Admin/Warden
ADMIN_CODE="warden123"

# Cloudinary Configuration (for file uploads)
# Sign up at: https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_api_key_here"
CLOUDINARY_API_SECRET="your_api_secret_here"

# Email Configuration (for notifications)
# For Gmail: Enable 2FA and generate App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-char-app-password"

# GEMINI_API_KEY: Optional
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

